{
  "name": "kastor-ai",
  "version": "1.0.0",
  "description": "Multi-Group WhatsApp Classroom Management Bot & Web Dashboard (ARAS 1.0)",
  "author": "Kastor AI Team",
  "license": "MIT",
  "main": "bot/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "node -e \"const fs = require('fs'); if (!fs.existsSync('.env')) fs.copyFileSync('.env.example', '.env'); console.log('✅ Template .env siap.');\" && node database/seed.js",
    "start": "node bot/index.js",
    "start:node": "node bot/index.js",
    "start:deno": "deno run --allow-all bot/index.js",
    "start:bun": "bun bot/index.js",
    "seed": "node database/seed.js",
    "seed:node": "node database/seed.js",
    "seed:deno": "deno run --allow-all database/seed.js",
    "seed:bun": "bun database/seed.js",
    "test": "node bot/test/run-tests.js",
    "test:node": "node bot/test/run-tests.js",
    "test:deno": "deno run --allow-all bot/test/run-tests.js",
    "test:bun": "bun bot/test/run-tests.js",
    "web": "node web/server.js",
    "web:node": "node web/server.js",
    "web:deno": "deno run --allow-all web/server.js",
    "web:bun": "bun web/server.js",
    "test:web": "node web/test/web-tests.js",
    "test:web:node": "node web/test/web-tests.js",
    "test:web:deno": "deno run --allow-all web/test/web-tests.js",
    "test:web:bun": "bun web/test/web-tests.js",
    "test:e2e": "node web/test/responsive-e2e.js",
    "test:e2e:node": "node web/test/responsive-e2e.js",
    "test:e2e:deno": "deno run --allow-all web/test/responsive-e2e.js",
    "test:e2e:bun": "bun web/test/responsive-e2e.js",
    "relogin": "rm -rf auth_info_baileys && node bot/index.js",
    "relogin:node": "rm -rf auth_info_baileys && node bot/index.js",
    "relogin:deno": "rm -rf auth_info_baileys && deno run --allow-all bot/index.js",
    "relogin:bun": "rm -rf auth_info_baileys && bun bot/index.js"
  },
  "keywords": [
    "whatsapp-bot",
    "classroom-management",
    "aras",
    "smk",
    "school-administration",
    "baileys",
    "sqlite-wal"
  ],
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "mathjs": "^12.4.3",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  }
}
