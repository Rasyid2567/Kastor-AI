# Multi-Group WhatsApp Classroom Management Bot Configuration

# Nomor WhatsApp Superadmin / Developer (tanpa +, format: 628xxxxxxxxxx)
DEVELOPER_NUMBER=6281234567890

# Zona Waktu
TIMEZONE=Asia/Jakarta

# Konfigurasi AI untuk Asisten Belajar
# Provider: "gemini" | "groq" | "ollama" | "openrouter"
AI_PROVIDER=gemini
AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-3.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Jika menggunakan Ollama lokal:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Konfigurasi Kastor AI Web Dashboard (Opsional)
WEB_PORT=3001
WEB_HOST=0.0.0.0
# DATABASE_PATH=./database.sqlite
